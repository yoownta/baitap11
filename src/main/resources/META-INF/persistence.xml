<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.1">
  <persistence-unit name="ktqt03PU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>vn.iotstar.ktqt03.entity.Category</class>
    <class>vn.iotstar.ktqt03.entity.User</class>
    <class>vn.iotstar.ktqt03.entity.Video</class>
    <class>vn.iotstar.ktqt03.entity.Favorite</class>
    <class>vn.iotstar.ktqt03.entity.Share</class>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
      <property name="hibernate.hbm2ddl.auto" value="validate"/>
      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.dialect" value="org.hibernate.dialect.SQLServerDialect"/>
    </properties>
  </persistence-unit>
</persistence>
